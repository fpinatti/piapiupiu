{
  "expo": {
    "name": "PiaPiuPiu - Wingsong",
    "slug": "piapiupiu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piapiupiu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O PiaPiuPiu precisa de acesso à câmera para identificar cartas do Wingspan via OCR."
      }
    },
    "android": {
      "package": "com.piapiupiu.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "O PiaPiuPiu precisa de acesso à câmera para identificar cartas do Wingspan via OCR."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O PiaPiuPiu precisa de acesso à câmera para identificar cartas do Wingspan via OCR.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "549b0ca8-949a-47bc-a491-9f6f350b6157"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/549b0ca8-949a-47bc-a491-9f6f350b6157"
    }
  }
}
